# Copy this file to .env. It is read only by the local Python server.
OPENROUTER_API_KEY=

# One OpenRouter model is used for the optional grounded summary.
# It must support response_format with JSON Schema.
OPENROUTER_MODEL=openai/gpt-4o-mini

# USD per 1 million tokens for the selected OpenRouter model.
# Blank means unknown, not free. Check the current model page before filling these.
OPENROUTER_INPUT_USD_PER_M=
OPENROUTER_OUTPUT_USD_PER_M=

# Optional assumed local device cost per hour.
LOCAL_COMPUTE_USD_PER_HOUR=

# Optional: cpu / mps / cuda. Default chooses an available device.
# CLIP_DEVICE=cpu

# Vision fallback: must support image input and JSON Schema.
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
